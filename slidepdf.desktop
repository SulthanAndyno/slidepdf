[Desktop Entry]
Version=1.0
Type=Application
Name=SlidePDF Studio
GenericName=PPTX to PDF Converter
Comment=Professional PowerPoint to PDF conversion studio with multi-engine support
Exec=/workspace/Projects/slidepdf/run.sh %F
Icon=/workspace/Projects/slidepdf/assets/icon.png
Terminal=false
Categories=Office;Utility;Graphics;
Keywords=pptx;pdf;converter;powerpoint;presentation;slides;odp;
MimeType=application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.presentation;
StartupNotify=true
Actions=Doctor;Batch;

[Desktop Action Doctor]
Name=Engine Diagnostics (Doctor)
Exec=/workspace/Projects/slidepdf/run.sh doctor
Terminal=true

[Desktop Action Batch]
Name=Batch Convert Folder
Exec=/workspace/Projects/slidepdf/run.sh batch
Terminal=true
